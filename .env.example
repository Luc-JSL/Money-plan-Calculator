# ---- Twitch app (https://dev.twitch.tv/console/apps -> Register Your Application) ----
# Category: "Application Integration". OAuth Redirect URL: http://localhost (unused but required).
# Client Type: "Public" (then no secret is needed). If you picked "Confidential", also set the secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---- What to watch ----
GAME_NAME=Grand Theft Auto VI
# GAME_ID=                # optional: skip the name lookup
TOP_STREAMS=15            # watch the N most-viewed live streams in that category (0-100)
CHANNELS=                 # comma-separated logins that are always watched, e.g. xqc,kaicenat
LANGUAGES=en              # comma-separated; empty = all languages
REFRESH_INTERVAL=120      # seconds between stream-list refreshes

# ---- Clip handling ----
HAS_DELAY=false           # true = clip what viewers saw (accounts for stream delay)
DOWNLOAD=true             # download each clip with yt-dlp
VERTICAL=true             # also render a 1080x1920 version with ffmpeg
CAPTIONS=true             # burn auto-captions into the vertical clip (pip install faster-whisper)
WHISPER_MODEL=small       # tiny / base / small / medium (bigger = slower, more accurate)
MAX_CLIPS_GB=5            # prune oldest clips past this size (0 = never)
MAX_CLIPS_KEEP=300        # or past this many clips (0 = never)
DATA_DIR=data             # tokens, logs and clips live here
DISCORD_WEBHOOK=          # optional: post every clip URL to a Discord channel
MAX_CLIPS_PER_HOUR=30     # global safety valve
LOG_LEVEL=INFO

# ---- Optional TikTok auto-posting (opt-in; read README section 5 first) ----
AUTO_POST=false           # true = post every vertical clip to TikTok automatically
TIKTOK_COOKIES=           # path to cookies.txt exported from tiktok.com while logged in
POST_TEMPLATE={display_name} on Twitch #twitch #clips #gta6 #gtavi

# ---- Detector tuning (defaults are sensible; see README-clipbot.md) ----
# DET_SHORT_WINDOW=10
# DET_LONG_WINDOW=120
# DET_WARMUP=60
# DET_SPIKE_MULTIPLIER=3
# DET_MIN_SHORT_RATE=1
# DET_MIN_BASELINE_RATE=0.25
# DET_MIN_UNIQUE_USERS=5
# DET_MIN_HYPE_FRACTION=0.35
# DET_CLIP_REQUEST_USERS=3
# DET_COOLDOWN=120
# DET_SUSTAIN=3             # spike must hold this many seconds (filters one-off emote waves)
# DET_RAID_SUPPRESS=120     # ignore a channel this long after an incoming raid
