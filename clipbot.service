# systemd unit for running clipbot on a Linux VPS without Docker.
# sudo cp clipbot.service /etc/systemd/system/ && sudo systemctl enable --now clipbot
[Unit]
Description=Twitch clipbot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/clipbot
ExecStart=/usr/bin/python3 -m clipbot run
Restart=always
RestartSec=10
User=clipbot

[Install]
WantedBy=multi-user.target
